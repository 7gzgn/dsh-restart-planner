{
  "name": "dsh-restart-planner",
  "version": "0.4.6",
  "description": "让 agent 自己能安排宿主重启：排程、到点动手，重启完自动接着刚才没做完的事继续。 Let the agent restart its own DSH host: schedule it, run it, and resume the same session afterwards.",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-restart-planner": "bin/dsh-restart-planner.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./plan": "./lib/plan.js",
    "./core": "./lib/core.js",
    "./helper.ps1": "./lib/helper.ps1",
    "./helper.mjs": "./lib/helper.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "restart",
    "self-restart",
    "relaunch",
    "reload",
    "hot-reload",
    "plugin-reload",
    "agent-automation",
    "process-control",
    "watchdog",
    "windows",
    "閲嶅惎",
    "鑷姩閲嶅惎"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/7gzgn/dsh-restart-planner.git"
  },
  "homepage": "https://github.com/7gzgn/dsh-restart-planner#readme",
  "bugs": {
    "url": "https://github.com/7gzgn/dsh-restart-planner/issues"
  },
  "dsh": {
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible",
        "0.2.2-rc.1": "compatible"
      }
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5.0.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
